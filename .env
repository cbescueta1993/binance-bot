# Copy this file to .env and fill in your own values, then load it
# before running the bot, e.g.:
#   export $(grep -v '^#' .env | xargs) && php bot.php

BINANCE_API_KEY=bLnWru3nQsTC8SObwWOUJcAJGxYMT82YlYcopWcaRQP2TnM1Cbjl7uxKZzHoAxbW
BINANCE_SECRET_KEY=bLnWru3nQsTC8SObwWOUJcAJGxYMT82YlYcopWcaRQP2TnM1Cbjl7uxKZzHoAxbW

SYMBOL=XRPUSDT
INTERVAL=5m

ATR_PERIOD=10
SUPERTREND_MULTIPLIER=3

BASE_MARGIN=11
MARTINGALE_MULTIPLIER=2
MAX_MARTINGALE_LEVEL=7

MARGIN_TYPE=CROSSED
LEVERAGE=30

TP_PERCENT=0.3
SL_PERCENT=0.5

# ALWAYS start with true. Only switch to false once you've watched
# the dry-run logs for a while and are comfortable with the sizing.
DRY_RUN=true

# Log timestamps use this timezone (PHP has no OS default, so
# without this, timestamps can be several hours off your clock).
TIMEZONE=Asia/Manila

# 'poll' fetches candles via plain REST GET on a timer instead of
# the persistent kline websocket - use this if wss:// connections
# connect but never receive data (seen on some networks/ISPs).
# 'websocket' is faster (near-instant candle close detection) but
# only use it once you've confirmed wss:// actually delivers data
# for you (see test-connection.php).
MARKET_DATA_MODE=poll
POLL_INTERVAL_SECONDS=15